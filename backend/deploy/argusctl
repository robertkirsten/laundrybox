#!/usr/bin/env bash
set -Eeuo pipefail

ENV_FILE=/etc/argus/argus.env
BACKEND=/opt/argus/venv/bin/argus-backend
DATABASE=/var/lib/argus/argus.sqlite3
BACKUP_DIR=/var/lib/argus/backups
LEGACY_FRONTEND_UNIT=smart-shaft.service

if [[ ! -f "$ENV_FILE" && -f /etc/argus/backend.env ]]; then
    ENV_FILE=/etc/argus/backend.env
fi

as_root() {
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

as_argus() {
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
        runuser -u argus -- "$@"
    else
        sudo -u argus "$@"
    fi
}

require_install() {
    [[ -x "$BACKEND" ]] || { echo "ARGUS is not installed under /opt/argus" >&2; exit 1; }
    [[ -f "$ENV_FILE" ]] || { echo "ARGUS config not found under /etc/argus" >&2; exit 1; }
}

unit_exists() {
    systemctl cat "$1" >/dev/null 2>&1
}

stop_legacy_frontend() {
    if unit_exists "$LEGACY_FRONTEND_UNIT"; then
        as_root systemctl stop "$LEGACY_FRONTEND_UNIT"
    fi
}

serial_monitor() {
    require_install
    local was_active=0 result=0
    if systemctl is-active --quiet argus-backend.service; then
        was_active=1
        as_root systemctl stop argus-backend.service
    fi
    restore_backend() {
        trap - EXIT INT TERM
        if [[ "$was_active" -eq 1 ]]; then
            as_root systemctl start argus-backend.service
        fi
    }
    trap restore_backend EXIT INT TERM
    as_argus "$BACKEND" --env-file "$ENV_FILE" serial-monitor "$@" || result=$?
    restore_backend
    return "$result"
}

led_test() {
    require_install
    local was_active=0 result=0
    if systemctl is-active --quiet argus-backend.service; then
        was_active=1
        as_root systemctl stop argus-backend.service
    fi
    restore_backend() {
        trap - EXIT INT TERM
        if [[ "$was_active" -eq 1 ]]; then
            as_root systemctl start argus-backend.service
        fi
    }
    trap restore_backend EXIT INT TERM
    as_argus "$BACKEND" --env-file "$ENV_FILE" led-test "$@" || result=$?
    restore_backend
    return "$result"
}

db_refresh() {
    require_install
    local assume_yes=0 arg
    for arg in "$@"; do
        case "$arg" in
            -y|--yes) assume_yes=1 ;;
            *) echo "unknown option for db-refresh: $arg" >&2; exit 2 ;;
        esac
    done

    if [[ "$assume_yes" -ne 1 ]]; then
        cat >&2 <<EOF
This PERMANENTLY DELETES the production database at
  $DATABASE
and rebuilds an empty schema seeded with mock data only. All real scan
history and registered garments are lost. A verified backup is written to
$BACKUP_DIR first.
EOF
        read -r -p "Type 'refresh' to continue: " reply
        [[ "$reply" == "refresh" ]] || { echo "Aborted." >&2; exit 1; }
    fi

    if as_argus test -f "$DATABASE"; then
        echo "==> Backing up current database"
        if ! as_argus "$BACKEND" --env-file "$ENV_FILE" backup "$BACKUP_DIR" --keep 14; then
            echo "Backup failed; refusing to delete the database." >&2
            exit 1
        fi
    else
        echo "==> No existing database found; skipping backup"
    fi

    # Only the backend holds the SQLite file open; the frontend just calls the
    # API and recovers on its own, so we leave it running.
    echo "==> Stopping backend to release the database"
    as_root systemctl stop argus-backend.service

    echo "==> Removing database and WAL sidecar files"
    as_root rm -f "$DATABASE" "$DATABASE-wal" "$DATABASE-shm"

    # Starting the backend runs 'alembic upgrade head' (ExecStartPre) against the
    # empty file, then the app seeds mock data during lifespan startup because
    # ARGUS_SEED_MOCK_DATA=true. Uvicorn only accepts requests once lifespan
    # startup (seeding) has finished, so a successful health call confirms it.
    echo "==> Starting backend (alembic rebuilds the schema; the app reseeds mock data)"
    if ! as_root systemctl start argus-backend.service; then
        echo "Backend failed to start; the pre-refresh backup is in $BACKUP_DIR." >&2
        echo "Inspect with 'argusctl logs'." >&2
        exit 1
    fi

    echo "==> Waiting for the backend to come up"
    local ready=0
    for _ in $(seq 1 30); do
        if curl -fsS http://127.0.0.1:8000/api/v1/health >/dev/null 2>&1; then
            ready=1
            break
        fi
        sleep 1
    done
    if [[ "$ready" -ne 1 ]]; then
        echo "Backend did not come up within 30s; the backup is in $BACKUP_DIR." >&2
        echo "Inspect with 'argusctl logs'." >&2
        exit 1
    fi

    # Seeding creates reference data (garments etc.), not scan history, so verify
    # by counting garments rather than scans.
    local garments="?"
    if command -v sqlite3 >/dev/null 2>&1; then
        garments=$(as_argus sqlite3 -readonly "$DATABASE" \
            "SELECT count(*) FROM garments;" 2>/dev/null || echo "?")
    fi
    echo "==> Refreshed. Seeded garments: $garments (the scan log starts empty)."
    curl -fsS http://127.0.0.1:8000/api/v1/health | python3 -m json.tool || true
}

usage() {
    cat <<'EOF'
Usage: argusctl COMMAND [OPTIONS]

Commands:
  status              Service and API status
  start|stop|restart  Control backend and frontend
  logs                Follow combined technical logs
  health              Pretty-print backend health
  state               Pretty-print current display state
  scans [options]     Clean EPC / garment / IST / SOLL log
  serial [options]    Safely stop backend, show raw serial, then restore it
  led-test [options]  Safely stop backend and fill the LED strip
  db                  Open the production SQLite database read-only
  db-refresh [--yes]  Back up, wipe, and reseed the production database
  backup              Run a verified database backup now

Examples:
  argusctl scans --follow
  argusctl scans --last 50 --csv
  argusctl serial --seconds 15
  argusctl led-test
  argusctl db-refresh
EOF
}

case "${1:-help}" in
    status)
        systemctl --no-pager --full status argus-backend.service argus-frontend.service || true
        echo
        curl -fsS http://127.0.0.1:8000/api/v1/health | python3 -m json.tool || true
        ;;
    start)
        action="$1"
        as_root systemctl "$action" argus-backend.service argus-frontend.service
        ;;
    stop)
        stop_legacy_frontend
        as_root systemctl stop argus-frontend.service argus-backend.service
        ;;
    restart)
        stop_legacy_frontend
        as_root systemctl restart argus-backend.service argus-frontend.service
        ;;
    logs)
        as_root journalctl -u argus-backend.service -u argus-frontend.service -f
        ;;
    health|state)
        endpoint="$1"
        curl -fsS "http://127.0.0.1:8000/api/v1/$endpoint" | python3 -m json.tool
        ;;
    scans)
        shift
        require_install
        as_argus "$BACKEND" --env-file "$ENV_FILE" scans "$@"
        ;;
    serial)
        shift
        serial_monitor "$@"
        ;;
    led-test)
        shift
        led_test "$@"
        ;;
    db)
        command -v sqlite3 >/dev/null 2>&1 || { echo "sqlite3 is not installed" >&2; exit 1; }
        if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
            exec runuser -u argus -- sqlite3 -readonly -header -column "$DATABASE"
        else
            exec sudo -u argus sqlite3 -readonly -header -column "$DATABASE"
        fi
        ;;
    db-refresh|db_refresh)
        shift
        db_refresh "$@"
        ;;
    backup)
        as_root systemctl start argus-backup.service
        as_root journalctl -u argus-backup.service -n 20 --no-pager
        ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
