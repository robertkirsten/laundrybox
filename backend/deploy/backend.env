ARGUS_DATABASE_URL=sqlite:////var/lib/argus/argus.sqlite3
ARGUS_LOG_LEVEL=INFO
ARGUS_JSON_LOGS=true
ARGUS_AUTO_CREATE_SCHEMA=false
ARGUS_SERIAL_PORT=/dev/argus-teensy
ARGUS_SERIAL_FALLBACK_PORT=/dev/ttyACM0
ARGUS_SERIAL_ENABLED=true
ARGUS_SEED_MOCK_DATA=true
ARGUS_MOCK_DATA_PATH=/etc/argus/mock_garments.csv
ARGUS_ENABLE_DEBUG_INGEST=false
ARGUS_THRESHOLD_G=3.0
ARGUS_EMPTY_WEIGHT_MAX_G=10.0
ARGUS_MIN_GARMENT_WEIGHT_G=50.0
ARGUS_MAX_GARMENT_WEIGHT_G=1000.0
ARGUS_STABILITY_TOLERANCE_G=2.0
ARGUS_STABILITY_WINDOW_SIZE=3
ARGUS_REMOVAL_CONFIRM_SAMPLES=3
ARGUS_MINIMUM_TAG_READS=2
ARGUS_ACQUISITION_TIMEOUT_S=6.0
ARGUS_INSPECTION_TIMEOUT_S=30.0
ARGUS_SERIAL_STALE_AFTER_S=2.0
ARGUS_STATION_CODE=ARGUS-01
ARGUS_OPERATOR_NUMBER=4471
ARGUS_CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
